{
  "name": "cutflow",
  "productName": "Cutflow",
  "version": "1.0.0",
  "homepage": "https://hamzaabika.com",
  "description": "Cutflow - free, open-source desktop video editor (Electron + React + FFmpeg)",
  "main": "electron/main.cjs",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/almarai": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/changa": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/el-messiri": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "@fontsource/kaushan-script": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/lemonada": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/marhey": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rakkas": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "@fontsource/satisfy": "^5.3.0",
    "@fontsource/shadows-into-light": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "@fontsource/yellowtail": "^5.3.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.469.0",
    "onnxruntime-node": "^1.31.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "author": "Hamza Abika",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "package:linux": "vite build && electron-builder --linux deb --x64"
  },
  "build": {
    "appId": "com.clipcraft.app",
    "afterPack": "build/after-pack.cjs",
    "productName": "Cutflow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/**/*",
      "bundled-templates/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "asarUnpack": [
      "bundled-templates/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "../clipcraft-pack-merged",
        "to": "clipcraft-pack",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Hamza Abika",
      "description": "Cutflow - free desktop video editor by Hamza Abika",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video"
    },
    "deb": {
      "afterInstall": "build/after-install.sh"
    }
  },
  "desktopName": "Cutflow"
}
